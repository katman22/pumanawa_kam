<% if showcase.items.empty? %>
  <% if introduction.present? %><p class="showcase-bio"><%= truncate(introduction, length: 360, separator: " ") %></p><% end %>
  <p class="whare-empty">Published work will be shared here soon.</p>
<% else %>
  <div class="showcase-wall showcase-wall--<%= showcase.size %>" aria-label="Selected work by <%= name %>">
    <% showcase.items.each_with_index do |item, index| %>
      <figure class="showcase-art showcase-slot--<%= item.slot %>" data-photo-id="<%= item.photo.id %>" data-orientation="<%= item.orientation %>">
        <%= link_to whare_pumanawa_mural_path(item.mural.slug), aria: { label: "View #{item.mural.title}" } do %>
          <%= image_tag item.photo.image.variant(:hero), alt: item.photo.alt_text, loading: index.zero? ? "eager" : "lazy" %>
        <% end %>
        <figcaption><%= item.mural.title %><% if item.mural.year.present? %> · <%= item.mural.year %><% end %></figcaption>
      </figure>
      <% if index.zero? && introduction.present? %>
        <aside class="showcase-text showcase-bio"><p class="whare-eyebrow"><%= introduction_label %></p><p><%= truncate(introduction, length: 360, separator: " ") %></p></aside>
      <% end %>
      <% if index == [1, showcase.items.length - 1].min && showcase.story %>
        <% mural = showcase.story %>
        <aside class="showcase-text showcase-story"><h2><%= mural.title %></h2><p class="showcase-caption"><%= [mural.location, mural.year, mural.client].select(&:present?).join(" · ") %></p><p><%= truncate(mural.description, length: 240, separator: " ") %></p><%= link_to "Read the story", whare_pumanawa_mural_path(mural.slug) %></aside>
      <% end %>
    <% end %>
    <div class="showcase-signature"><p>Built by Whare Pūmanawa</p><p><%= name %></p><% if location.present? %><p><%= location %></p><% end %></div>
  </div>
<% end %>
