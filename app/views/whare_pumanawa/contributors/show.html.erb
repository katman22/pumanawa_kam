<header class="showcase-intro">
  <p class="whare-eyebrow">Mahi Tahi · Contributor showcase</p>
  <h1><%= @contributor.name %></h1>
  <% if @contributor.location.present? %><p><%= @contributor.location %></p><% end %>
</header>
<%= render "whare_pumanawa/shared/showcase_wall", showcase: @showcase, name: @contributor.name, location: @contributor.location, introduction: @contributor.bio, introduction_label: "In their words" %>
<p class="showcase-return"><%= link_to "Explore organizations", whare_pumanawa_root_path %></p>
