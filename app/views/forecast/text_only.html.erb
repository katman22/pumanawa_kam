<div class="weather_div forecast-full forecast-text-only">
  <%= render "full_header", location_context: @location_context, forecast_label: "Text Only Forecast", show_full_forecast: true %>
  <% if @erred %>
    <p class="forecast-full-error" role="alert">Error Response: <%= @forecasts %></p>
  <% else %>
    <main aria-label="Text only forecast periods">
      <% if @forecasts.blank? %>
        <p>No forecast periods available.</p>
      <% end %>
      <% @forecasts.each_with_index do |raw_forecast, index| %>
        <% forecast = raw_forecast.with_indifferent_access %>
        <section class="forecast-full-detail" aria-labelledby="text-forecast-period-<%= index %>">
          <h2 id="text-forecast-period-<%= index %>"><%= forecast[:name] %></h2>
          <p class="forecast-full-text"><%= forecast[:detailedForecast] %></p>
        </section>
      <% end %>
    </main>
  <% end %>
</div>
