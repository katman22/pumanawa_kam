<turbo-frame id="<%= turbo_location %>">
  <% if erred %>
    <p class="forecast-full-error" role="alert">Location search is currently unavailable. Please try again.</p>
  <% elsif locations.empty? %>
    <p>No locations found for <%= location %>. Please try another search.</p>
  <% else %>
    <p>Choose a location for <%= location %>:</p>
    <ul class="forecast-dual-candidates">
      <% locations.each do |raw_location| %>
        <% candidate = raw_location.with_indifferent_access %>
        <li>
          <%= form_with url: forecast_dual_full_path, method: :post, data: { turbo_frame: turbo_location } do %>
            <%= hidden_field_tag :location, location %>
            <%= hidden_field_tag :lat, candidate[:lat] %>
            <%= hidden_field_tag :long, candidate[:lng] %>
            <%= hidden_field_tag :location_name, candidate[:name] %>
            <%= hidden_field_tag :country_code, candidate[:country_code] %>
            <%= hidden_field_tag :turbo_location, turbo_location %>
            <%= button_tag "Load #{candidate[:name]}", class: "btn btn-outline-primary" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</turbo-frame>
