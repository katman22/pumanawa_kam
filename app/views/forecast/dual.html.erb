<div class="weather_div forecast-full forecast-dual">
  <%= render "full_header", page_title: "Dual Forecast", dual_page: true %>
  <main>
    <div class="forecast-dual-search" data-controller="recent-location">
      <%= form_with url: forecast_dual_geo_location_path, method: :post, class: "dual_forecast_form", id: "location_form" do %>
        <%= label_tag :location, "Location" %>
        <%= text_field_tag :location, params[:location], placeholder: "City, state, zip OR latitude, longitude", class: "weather_input", data: { "recent-location-target": "input" } %>
        <div class="d-flex flex-wrap gap-2">
          <%= button_tag "Load Location A", name: "commit", value: BaseForecaster::SCREEN_A, class: "btn btn-primary", data: { turbo_frame: "location_response_a" } %>
          <%= button_tag "Load Location B", name: "commit", value: BaseForecaster::SCREEN_B, class: "btn btn-primary", data: { turbo_frame: "location_response_b" } %>
        </div>
      <% end %>
      <% if @recent_locations.present? %>
        <section class="forecast-dual-recent" aria-labelledby="dual-recent-title">
          <h2 id="dual-recent-title">Recent Search Locations</h2>
          <% @recent_locations.each do |raw_recent| %>
            <% recent = raw_recent.with_indifferent_access %>
            <% if recent[:latitude].present? && recent[:longitude].present? %>
              <button type="button" class="btn btn-outline-secondary" data-action="click->recent-location#select" data-lat="<%= recent[:latitude] %>" data-lng="<%= recent[:longitude] %>"><%= recent[:location_name].presence || recent[:location].presence || "#{recent[:latitude]}, #{recent[:longitude]}" %></button>
            <% end %>
          <% end %>
        </section>
      <% end %>
    </div>
    <div class="forecast-dual-grid">
      <% %w[a b].each do |side| %>
        <section class="forecast-dual-side" aria-labelledby="dual-side-<%= side %>">
          <h2 id="dual-side-<%= side %>">Location <%= side.upcase %></h2>
          <turbo-frame id="location_response_<%= side %>">
            <p>Search for a location and choose Load Location <%= side.upcase %>.</p>
          </turbo-frame>
        </section>
      <% end %>
    </div>
  </main>
</div>
