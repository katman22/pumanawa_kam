<% period_prefix = local_assigns[:period_prefix] || "forecast-period" %>
<section id="<%= period_prefix %>-detail-<%= index %>"
         class="forecast-full-detail"
         aria-labelledby="<%= period_prefix %>-title-<%= index %>"
         data-forecast-periods-target="detail">
  <h3 id="<%= period_prefix %>-title-<%= index %>"><%= forecast[:name] %></h3>
  <p><strong>In Brief:</strong> <%= forecast[:shortForecast] %></p>
  <dl class="forecast-full-metrics">
    <div><dt>Temperature</dt><dd><%= forecast[:temperature] %>&deg; <%= forecast[:temperatureUnit] %></dd></div>
    <div><dt>Wind Direction</dt><dd><%= forecast[:windDirection] %></dd></div>
    <div><dt>Wind Speed</dt><dd><%= forecast[:windSpeed] %></dd></div>
    <div><dt>Chance of Precipitation</dt><dd><%= forecast.dig(:probabilityOfPrecipitation, :value) || 0 %>%</dd></div>
  </dl>
  <p class="forecast-full-text"><%= forecast[:detailedForecast] %></p>
</section>
