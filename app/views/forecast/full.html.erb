<div class="weather_div forecast-full">
  <%= render "full_header", location_context: @location_context %>

  <% if @erred %>
    <p class="forecast-full-error" role="alert">Error Response: <%= @forecasts %></p>
  <% else %>
    <main class="forecast-full-layout" data-controller="forecast-tabs">
      <div class="forecast-full-tabs" role="tablist" aria-label="Weather information" data-forecast-tabs-target="tablist" hidden>
        <% [["periods", "Forecast Periods"], ["discussion", "Discussion"], ["alerts", @alerts_available && @alerts.any? ? "Alerts (#{@alerts.size})" : "Alerts"]].each do |key, label| %>
          <button type="button" role="tab" id="forecast-tab-<%= key %>" aria-controls="forecast-panel-<%= key %>" aria-selected="<%= key == 'periods' %>" tabindex="<%= key == 'periods' ? 0 : -1 %>" data-forecast-tabs-target="tab" data-action="click->forecast-tabs#select keydown->forecast-tabs#navigate"><%= label %></button>
        <% end %>
      </div>
      <section id="forecast-panel-periods" data-forecast-tabs-target="panel" aria-labelledby="forecast-tab-periods">
      <div class="forecast-full-periods" data-controller="forecast-periods">
        <h2>Forecast periods</h2>
        <% if @forecasts.blank? %>
          <p>No forecast periods available.</p>
        <% else %>
          <div class="forecast-full-strip" aria-label="Choose a forecast period">
            <% @forecasts.each_with_index do |forecast, index| %>
              <%= render "period_card", forecast: forecast.with_indifferent_access, index: index %>
            <% end %>
          </div>
          <div class="forecast-full-details">
            <% @forecasts.each_with_index do |forecast, index| %>
              <%= render "period_detail", forecast: forecast.with_indifferent_access, index: index %>
            <% end %>
          </div>
        <% end %>
      </div>
      </section>
      <section id="forecast-panel-discussion" data-forecast-tabs-target="panel" aria-labelledby="forecast-tab-discussion">
        <%= render "discussion", discussion: @discussion %>
      </section>
      <section id="forecast-panel-alerts" data-forecast-tabs-target="panel" aria-labelledby="forecast-tab-alerts">
        <%= render "alerts", alerts: @alerts, available: @alerts_available %>
      </section>
    </main>
  <% end %>
</div>
