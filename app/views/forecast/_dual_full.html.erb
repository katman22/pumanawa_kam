<% period_prefix = "dual-#{turbo_location.last}-period" %>
<turbo-frame id="<%= turbo_location %>">
  <h3><%= location_context.location_name.presence || location_context.location.presence || "Current location" %></h3>
  <% if location_context.latitude.present? && location_context.longitude.present? && location_context.country_code.present? %>
    <div class="forecast-dual-links d-flex flex-wrap gap-2 mb-3">
      <%= link_to "Full Forecast", forecast_full_path(
        lat: location_context.latitude, long: location_context.longitude,
        country_code: location_context.country_code,
        location: location_context.location, location_name: location_context.location_name
      ), class: "btn btn-outline-primary btn-sm", data: { turbo: false, turbo_frame: "_top" } %>
      <%= link_to "View Radar", radar_for_locale_web_path(
        lat: location_context.latitude, lng: location_context.longitude,
        country_code: location_context.country_code,
        location: location_context.location, location_name: location_context.location_name,
        type: "radar"
      ), class: "btn btn-outline-primary btn-sm", data: { turbo: false, turbo_frame: "_top" } %>
    </div>
  <% end %>
  <% if erred %>
    <p class="forecast-full-error" role="alert">Error Response: <%= forecasts %></p>
  <% else %>
    <div data-controller="forecast-periods">
      <% if forecasts.blank? %>
        <p>No forecast periods available.</p>
      <% else %>
        <div class="forecast-full-strip" aria-label="Choose a forecast period">
          <% forecasts.each_with_index do |forecast, index| %>
            <%= render "period_card", forecast: forecast.with_indifferent_access, index: index, period_prefix: period_prefix %>
          <% end %>
        </div>
        <div class="forecast-full-details">
          <% forecasts.each_with_index do |forecast, index| %>
            <%= render "period_detail", forecast: forecast.with_indifferent_access, index: index, period_prefix: period_prefix %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
