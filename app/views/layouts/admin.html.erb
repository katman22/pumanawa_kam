<!-- app/views/layouts/admin.html.erb -->
<!DOCTYPE html>
<html lang="en">
<head>
  <title>Admin</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <%= stylesheet_link_tag "admin_tokens", "admin_shell", "data-turbo-track": "reload" %>

</head>
<body class="admin-shell admin-shell--<%= %w[admin/resorts admin/resort_filters admin/cameras admin/parking_profiles].include?(controller_path) ? 'canyon' : 'default' %>">
<div class="admin-frame">
<header class="admin-header" data-controller="admin-navigation" data-action="keydown.esc->admin-navigation#close">
  <button type="button" class="admin-menu-toggle" hidden aria-expanded="false" aria-controls="admin-navigation" data-admin-navigation-target="button" data-action="admin-navigation#toggle"><span aria-hidden="true">☰</span> Menu</button>
  <nav id="admin-navigation" class="admin-nav" aria-label="Administration" data-admin-navigation-target="menu">
    <%= link_to "Dashboard", admin_root_path, class: "btn" %>
    <% if current_admin_user.can_administer_canyon? %>
      <%= link_to "Canyon / Resorts", admin_resorts_path, class: "btn" %>
    <% end %>
    <% if current_admin_user.can_administer_murals? %>
      <%= link_to "Mahi Tahi / Organizations", admin_whare_pumanawa_organizations_path, class: "btn" %>
      <%= link_to "Projects", admin_whare_pumanawa_projects_path, class: "btn" %>
      <%= link_to "Contributors", admin_whare_pumanawa_contributors_path, class: "btn" %>
      <%= link_to "Murals", admin_whare_pumanawa_murals_path, class: "btn" %>
    <% end %>
    <% if current_admin_user.super_admin? %>
      <%= link_to "Users", admin_users_path, class: "btn" %>
    <% end %>
    <%= button_to "Sign out", admin_logout_path, method: :delete, class: "btn", form: { class: "d-inline" } %>
  </nav>
</header>
<% flash.each do |type, message| %>
  <p role="status" class="alert <%= type == "alert" ? "alert-danger" : "alert-success" %>"><%= message %></p>
<% end %>
<main class="admin-content"><%= yield %></main>
<footer class="admin-footer">
  <p>Built by Whare Pūmanawa</p>
  <%= image_tag "whare_pumanawa_mark_v2.svg", alt: "", class: "admin-maker-mark", aria: { hidden: true } %>
</footer>
</div>
<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
