<!-- app/views/layouts/admin.html.erb -->
<!DOCTYPE html>
<html lang="en">
<head>
  <title>Admin</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
      body { font-family: system-ui, sans-serif; margin: 1.5rem; }
  </style>

</head>
<body>
<header style="display:flex; gap:1rem; align-items:center; flex-wrap:wrap; margin-bottom:1rem;">
  <h4 style="margin-bottom:10px; margin-left: 10px; margin-top: 10px">Admin</h4>
  <nav style="display:flex; gap:.5rem; flex-wrap:wrap;">
    <%= link_to "Dashboard", admin_root_path, class: "btn" %>
    <% if current_admin_user.can_administer_canyon? %>
      <%= link_to "Canyon / Resorts", admin_resorts_path, class: "btn" %>
      <%= link_to "New Resort", new_admin_resort_path, class: "btn btn-primary" %>
    <% end %>
    <% if current_admin_user.can_administer_murals? %>
      <%= link_to "Whare Pūmanawa / Projects", admin_whare_pumanawa_projects_path, class: "btn" %>
      <%= link_to "Contributors", admin_whare_pumanawa_contributors_path, class: "btn" %>
      <%= link_to "Murals", admin_whare_pumanawa_murals_path, class: "btn" %>
    <% end %>
    <% if current_admin_user.super_admin? %>
      <%= link_to "Users", admin_users_path, class: "btn" %>
    <% end %>
    <%= button_to "Sign out", admin_logout_path, method: :delete, class: "btn", form: { class: "d-inline" } %>
  </nav>
</header>
<% flash.each do |type, message| %>
  <p role="status" class="alert <%= type == "alert" ? "alert-danger" : "alert-success" %>"><%= message %></p>
<% end %>
<%= yield %>
<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
