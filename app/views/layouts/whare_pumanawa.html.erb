<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= @project ? "#{@project.name} · " : @organization ? "#{@organization.name} · " : @contributor ? "#{@contributor.name} · " : (@mural ? "#{@mural.title} · " : "") %>Mahi Tahi</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "whare_pumanawa", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="whare-portfolio">
    <main class="whare-content"><%= yield %></main>
    <footer class="whare-footer">
      <p>Built by Whare Pūmanawa</p>
      <%= image_tag "whare_pumanawa_mark_v2.svg", alt: "", class: "whare-maker-mark", aria: { hidden: true } %>
    </footer>
  </body>
</html>
