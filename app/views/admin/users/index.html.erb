<h1>Administrators</h1>
<p><%= link_to "New administrator", new_admin_user_path, class: "btn btn-primary" %></p>
<div class="table-responsive"><table class="table">
  <thead><tr><th>Username</th><th>Role</th><th>Status</th><th>Manage</th></tr></thead>
  <tbody><% @users.each do |user| %>
    <tr><td><%= user.username %></td><td><%= user.role.humanize %></td><td><%= user.active? ? "Active" : "Inactive" %></td><td><%= link_to "Edit #{user.username}", edit_admin_user_path(user) %></td></tr>
  <% end %></tbody>
</table></div>
