<% sections = {"monitor-state" => ["overview", "Monitor state"], "source-quality" => ["overview", "Source / quality"],
          "current-forecast" => ["evidence", "Current forecast"], "forecast-history" => ["evidence", "Forecast history"],
          "monitor-decision" => ["decisions", "Cadence / decision"], "alert-history" => ["alerts", "NOAA alert history"]} %>
<div class="weather-monitoring" data-controller="weather-detail-links" data-weather-detail-links-tab-value="<%= @detail_tab %>" data-weather-detail-links-sections-value="<%= sections.transform_values(&:first).to_json %>">
  <p><%= link_to "Weather Monitoring", admin_weather_monitoring_path %> / <%= link_to "Resort administration", admin_resort_path(@resort) %></p>
  <h1><%= @resort.resort_name %> · Weather Monitoring</h1>
  <nav class="weather-tabs" aria-label="Resort monitoring sections">
    <% [["overview", "Overview"], ["evidence", "Forecast Evidence"], ["decisions", "Decisions"], ["alerts", "Alert History"]].each do |tab, label| %>
      <%= link_to label, admin_weather_monitoring_resort_path(@resort, tab: tab), aria: { current: ("page" if @detail_tab == tab) } %>
    <% end %>
  </nav>
  <noscript>
    <nav class="weather-section-links" aria-label="Legacy evidence links">
      <% sections.each do |id, (tab, label)| %>
        <% unless @detail_tab == tab %>
          <%= link_to label, admin_weather_monitoring_resort_path(@resort, tab: tab, anchor: id), id: id %>
        <% end %>
      <% end %>
    </nav>
  </noscript>
  <%= render "resort_#{@detail_tab}" %>
</div>
