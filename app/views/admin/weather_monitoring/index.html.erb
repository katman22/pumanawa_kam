<div class="weather-monitoring">
  <h1>Weather Monitoring</h1>
  <p>Canyon Traveller · NOAA monitoring pilot</p>
  <nav class="weather-tabs" aria-label="Weather monitoring sections">
    <% [[:forecasts, "Forecasts", admin_weather_monitoring_path],
        [:alerts, "Alerts", admin_weather_monitoring_alerts_path],
        [:history, "History", admin_weather_monitoring_history_path]].each do |tab, label, path| %>
      <%= link_to label, path, aria: { current: ("page" if @tab == tab) } %>
    <% end %>
  </nav>
  <section aria-label="<%= @tab.to_s.humanize %>" class="weather-tab-content">
    <%= render(@tab == :alerts ? "acquisitions" : @tab.to_s) %>
  </section>
</div>
