<h1><%= @project.name %></h1>
<% if @project.organization %><p>Organization: <%= link_to @project.organization.name, admin_whare_pumanawa_organization_path(@project.organization) %></p><% end %>
<p><strong><%= @project.active? ? "Active" : "Inactive" %></strong><% if @project.location.present? %> · <%= @project.location %><% end %></p>
<%= simple_format(h(@project.description)) if @project.description.present? %>
<p><%= link_to "Edit project", edit_admin_whare_pumanawa_project_path(@project) %> · <%= link_to "All projects", admin_whare_pumanawa_projects_path %></p>
<section aria-labelledby="project-murals-heading"><h2 id="project-murals-heading">Murals</h2>
<p><%= link_to "New mural in this project", new_admin_whare_pumanawa_mural_path(project_id: @project.id), class: "btn btn-primary" %></p>
<ul><% @murals.each do |mural| %><li><%= link_to mural.title, edit_admin_whare_pumanawa_mural_path(mural) %> · <%= mural.published? ? "Published" : "Draft" %></li><% end %></ul>
<% if @murals.empty? %><p>No murals in this project yet.</p><% end %></section>
<section aria-labelledby="project-members-heading"><h2 id="project-members-heading">Members</h2>
<p>Super admins have access without membership.</p>
<ul><% @memberships.each do |membership| %><li><%= membership.admin_user.username %><% unless membership.admin_user.active? && membership.admin_user.mural_admin? %> (currently ineligible; access denied)<% end %>
<% if current_admin_user.super_admin? %><%= button_to "Remove #{membership.admin_user.username}", admin_whare_pumanawa_project_project_membership_path(@project, membership), method: :delete, class: "btn btn-outline-danger btn-sm", form: { class: "d-inline", data: { turbo_confirm: "Remove this member's project access?" } } %><% end %></li><% end %></ul>
<% if current_admin_user.super_admin? %>
  <%= form_with url: admin_whare_pumanawa_project_project_memberships_path(@project), scope: :project_membership do |form| %>
    <div class="mb-3"><%= form.label :admin_user_id, "Add mural administrator" %><%= form.collection_select :admin_user_id, @eligible_admins, :id, :username, { include_blank: "Choose a mural admin" }, required: true, class: "form-select" %></div>
    <%= form.submit "Add member", class: "btn btn-primary" %>
  <% end %>
<% end %></section>
