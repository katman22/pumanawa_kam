<% if @project.errors.any? %><div role="alert" class="alert alert-danger"><ul><% @project.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
<%= form_with model: @project, url: @project.persisted? ? admin_whare_pumanawa_project_path(@project) : admin_whare_pumanawa_projects_path do |form| %>
  <div class="mb-3"><%= form.label :name %><%= form.text_field :name, required: true, class: "form-control" %></div>
  <div class="mb-3"><%= form.label :description, "Description (plain text)" %><%= form.text_area :description, rows: 5, class: "form-control" %></div>
  <div class="mb-3"><%= form.label :location %><%= form.text_field :location, class: "form-control" %></div>
  <div class="mb-3"><%= form.label :position %><%= form.number_field :position, min: 0, required: true, class: "form-control" %></div>
  <div class="mb-3"><%= form.check_box :active %> <%= form.label :active %><p class="form-text">Inactive projects remain editable by members. This does not unpublish murals.</p></div>
  <%= form.submit "Save project", class: "btn btn-primary" %> <%= link_to "Back to projects", admin_whare_pumanawa_projects_path %>
<% end %>
